{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thebrazenbeard/fuckup/schema/fuckup-retrospective.schema.json",
  "title": "F.U.C.K.U.P. Retrospective",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "incident", "flag", "understand", "calibrate", "know", "unlearn", "prevent"],
  "properties": {
    "protocol_version": {"type": "string", "minLength": 1},
    "incident": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "occurred_at", "system"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "occurred_at": {"type": "string", "format": "date-time"},
        "system": {"type": "string", "minLength": 1},
        "environment": {"type": ["string", "null"]},
        "severity": {"type": ["string", "null"]},
        "fingerprint": {"type": ["string", "null"]},
        "source_ref": {"type": ["string", "null"]}
      }
    },
    "flag": {
      "type": "object",
      "required": ["expected", "actual"],
      "properties": {
        "expected": {},
        "actual": {},
        "violated_expectation": {},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "understand": {
      "type": "object",
      "properties": {
        "trigger": {},
        "sequence": {"type": "array", "items": {}},
        "dependencies": {"type": "array", "items": {}},
        "missing_evidence": {"type": "array", "items": {}},
        "competing_explanations": {"type": "array", "items": {}}
      }
    },
    "calibrate": {
      "type": "object",
      "properties": {
        "immediate_adjustment": {},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "ambiguous": {"type": "boolean"},
        "ambiguity_reason": {},
        "containment": {},
        "escalation": {}
      }
    },
    "know": {
      "type": "object",
      "required": ["root_cause_proposition", "status"],
      "properties": {
        "root_cause_proposition": {},
        "supporting_evidence": {"type": "array", "items": {}},
        "counterevidence": {"type": "array", "items": {}},
        "alternatives": {"type": "array", "items": {}},
        "scope": {},
        "falsifier": {},
        "status": {"enum": ["PROPOSED", "SUPPORTED", "AMBIGUOUS", "REJECTED"]}
      }
    },
    "unlearn": {
      "type": "object",
      "required": ["prior_behavior", "correction_candidate"],
      "properties": {
        "prior_behavior": {},
        "correction_candidate": {},
        "supersedes": {"type": ["string", "null"]},
        "scope": {},
        "reversible": {"type": "boolean"},
        "qualification_required": {"type": "boolean"}
      }
    },
    "prevent": {
      "type": "object",
      "required": ["claim", "controls", "state"],
      "properties": {
        "claim": {},
        "controls": {"type": "array", "items": {"type": "string"}},
        "qualification_refs": {"type": "array", "items": {"type": "string"}},
        "activation_scope": {},
        "rollback_condition": {},
        "state": {
          "enum": ["PROPOSED", "QUALIFYING", "QUALIFIED", "PROMOTED", "ACTIVE", "REJECTED", "REVOKED", "SUPERSEDED"]
        }
      }
    }
  }
}
